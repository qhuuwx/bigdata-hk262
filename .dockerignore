# ==============================================================================
# .dockerignore - Docker Build Context Optimization
# Prevents host artifacts, large non-source folders, and temporary files
# from being transferred to the Docker daemon.
# ==============================================================================

# Dependencies (installed freshly inside Linux containers)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Version control & repository metadata
.git/
.gitignore

# Teamwork agent & AI tooling metadata
.agents/
.gemini/

# Output and temporary results
data/results/
*.tmp
*.log

# Editor & IDE configurations
.vscode/
.idea/
*.sublime-*

# OS-generated files
.DS_Store
Thumbs.db
