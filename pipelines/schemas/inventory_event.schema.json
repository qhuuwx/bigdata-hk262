{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RetailInventoryEvent",
  "type": "object",
  "required": [
    "Start Date",
    "End Date",
    "Stock Status",
    "Product No",
    "Product Division",
    "Product Category",
    "Store",
    "Sales Channel",
    "Qty on hand",
    "Stocks Selling Amount",
    "Cost of Stocks",
    "Stock Unit Selling Price",
    "Stock Unit Cost Price"
  ],
  "properties": {
    "Start Date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "End Date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "Stock Status": {
      "type": "string",
      "minLength": 1
    },
    "Supplier": {
      "type": ["string", "null"]
    },
    "Product No": {
      "type": "string",
      "pattern": "^PROD-[A-Za-z0-9_-]+$"
    },
    "Product Division": {
      "type": "string",
      "minLength": 1
    },
    "Product Category": {
      "type": "string",
      "minLength": 1
    },
    "Store": {
      "type": "string",
      "pattern": "^STR-[A-Za-z0-9_-]+$"
    },
    "Store Type": {
      "type": ["string", "null"]
    },
    "Sales Channel": {
      "type": "string",
      "minLength": 1
    },
    "Qty on hand": {
      "type": ["number", "integer", "string"]
    },
    "Stocks Selling Amount": {
      "type": ["number", "string"]
    },
    "Cost of Stocks": {
      "type": ["number", "string"]
    },
    "Stock Unit Selling Price": {
      "type": ["number", "string"]
    },
    "Stock Unit Cost Price": {
      "type": ["number", "string"]
    }
  },
  "additionalProperties": true
}
